# Production example for https://finance.arix.vu
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=https://finance.arix.vu
NEXTAUTH_URL=https://finance.arix.vu

ADMIN_EMAIL=admin@finance.arix.vu
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin

# Must be unique on the server (do not reuse ports of other /opt apps)
PORT=3010
HOST=127.0.0.1
NODE_ENV=production
